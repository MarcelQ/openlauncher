<?xml version="1.0" encoding="utf-8"?>
<!-- aospDebug overlay (manifest merger): the privileged EXPERIMENT build must be
     a normal drawer-launchable app, not a home candidate. SPD head-unit app
     drawers hide apps that declare CATEGORY_HOME, and two identically-named
     launchers on one unit is a usability trap. So this build type removes the
     HOME role from MainActivity and carries a distinct label. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Signature|privileged permissions for the EMBED card engines
         (TaskEmbedder / TaskOrganizer). Granted automatically once the app
         installs as android.uid.system with the matching platform signature;
         harmless in every other install. -->
    <uses-permission android:name="android.permission.ACTIVITY_EMBEDDING" />
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_STACKS" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <!-- VirtualDisplayTaskEmbedder (round 9): VIRTUAL_DISPLAY_FLAG_TRUSTED on
         createVirtualDisplay is gated by INTERNAL_SYSTEM_WINDOW, and the
         engine's performBackPress uses InputManager.injectInputEvent →
         INJECT_EVENTS. Both signature-level: auto-granted at uid 1000,
         inert on every other install. -->
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />
    <uses-permission android:name="android.permission.INJECT_EVENTS" />
    <!-- Updater round 10 (2026-11-20): the SPD unit's installer UI never shows
         for our ACTION_VIEW handoff (startActivity throws nothing — either the
         installer crash-loops hidden behind hide_error_dialogs=1, or the launch
         lands behind the HOME task). Bench builds run as android.uid.system with
         the platform signature, so INSTALL_PACKAGES (signature|privileged) is
         auto-granted and the in-app updater can install through a
         PackageInstaller session directly — no installer UI, no "install
         unknown apps" grant, and normal builds never request it at all. -->
    <uses-permission android:name="android.permission.INSTALL_PACKAGES" />

    <application
        android:label="Open Launcher AOSP-TEST"
        tools:replace="android:label">

        <activity android:name=".MainActivity">
            <!-- removeAll: intent-filters only pair with lower-priority ones of
                 byte-identical content, so partial matching can't drop HOME.
                 Clear the activity's filters (HOME launcher + TPMS-USB stick
                 auto-launch — neither is needed by the bench experiment) and
                 re-add a plain app icon filter. -->
            <intent-filter tools:node="removeAll" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
